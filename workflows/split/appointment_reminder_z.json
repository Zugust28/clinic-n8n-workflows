{
  "name": "appointment_reminder_z",
  "nodes": [
    {
      "id": "GCalRead",
      "name": "Google Calendar Read +2d",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -1060,
        820
      ],
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "jinsooclinic4@gmail.com",
          "mode": "id"
        },
        "returnAll": true,
        "options": {
          "timeMin": "={{$now.toISO()}}",
          "timeMax": "={{$now.plus({ days: 2 }).toISO()}}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_GOOGLE_CALENDAR_CRED_ID",
          "name": "Google Calendar OAuth2"
        }
      }
    },
    {
      "id": "CodeConfirm",
      "name": "Build Tomorrow Confirm (Z)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -840,
        820
      ],
      "parameters": {
        "jsCode": "const n=new Date();const t=new Date(n.getFullYear(),n.getMonth(),n.getDate()+1);const out=[];for(const i of $input.all()){const e=i.json;const txt=`${e.summary||''} ${e.description||''}`;if(!txt.includes('Z'))continue;const s=new Date(e.start?.dateTime||e.start?.date||'');if(String(s)==='Invalid Date')continue;if(s.getFullYear()===t.getFullYear()&&s.getMonth()===t.getMonth()&&s.getDate()===t.getDate()){const m=txt.match(/UID[:= ]([A-Za-z0-9_-]+)/i);const uid=m?m[1]:'';if(!uid)continue;const hh=String(s.getHours()).padStart(2,'0');const mm=String(s.getMinutes()).padStart(2,'0');out.push({json:{uid,message:`สวัสดีครับ 🙏 ขอคอนเฟิร์มนัดของพรุ่งนี้เวลา ${hh}.${mm} น. นะครับ หากไม่สะดวกแจ้งเลื่อนได้ครับ`,type:'CONFIRM_TOMORROW'}})}}return out.map(x=>({json:{...x.json,debugEvent:'confirm_candidate'}}));"
      }
    },
    {
      "id": "LineSendConfirm",
      "name": "DebugLog - Send Confirm",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -620,
        820
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LINE_CHANNEL_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "expression",
        "jsonBody": "={{ { to: $json.uid, messages: [{ type: 'text', text: $json.message }] } }}",
        "options": {}
      }
    },
    {
      "id": "DebugLogAppend",
      "name": "DebugLog - Append Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        980,
        420
      ],
      "parameters": {
        "operation": "append",
        "documentId": "1PJd4HTQmHKgHFI_DwimOrxGst6QRTr3lAjjkyvT7_Yk",
        "sheetName": "DebugLog",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{$now.toISO()}}",
            "Event": "={{$json.debugEvent || $json.type || \"unknown\"}}",
            "Details": "={{$json.debugDetails || $json.message || \"\"}}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CRED_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Google Calendar Read +2d": {
      "main": [
        [
          {
            "node": "Build Tomorrow Confirm (Z)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Tomorrow Confirm (Z)": {
      "main": [
        [
          {
            "node": "LINE Send Confirm",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
