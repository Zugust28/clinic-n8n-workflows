    {
      "id": "CodeFollow",
      "name": "Build Followup/Birthday/Botox4M",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -840,
        560
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json);const out=[];const now=new Date();const t=new Date(now.getFullYear(),now.getMonth(),now.getDate());const dd=(a,b)=>Math.round((new Date(a.getFullYear(),a.getMonth(),a.getDate())-new Date(b.getFullYear(),b.getMonth(),b.getDate()))/86400000);for(const r of rows){const uid=r.UID||'';if(!uid)continue;const name=r['ชื่อลูกค้า']||'';const done=new Date(r['วันที่ทำ']||'');if(String(done)!=='Invalid Date'){const d=dd(t,done);if([1,7,14].includes(d)){let m=d===1?`สวัสดีครับ${name?`คุณ${name}`:''} 🙏\\nหนูขออนุญาตติดตามอาการหลังทำหัตถการวันแรก เป็นอย่างไรบ้างครับ มีอาการบวม หรือไม่สบายตัวตรงไหนไหมครับ`:d===7?`สวัสดีครับ${name?`คุณ${name}`:''} 🙏\\nหนูขอติดตามอาการหลังทำหัตถการครบ 7 วันนะครับ`:`สวัสดีครับ${name?`คุณ${name}`:''} 🙏\\nหนูขอติดตามผลครบ 14 วันนะครับ`;out.push({json:{uid,message:m,type:`FOLLOWUP_D${d}`}})}}const b=new Date(r['วันเกิด']||'');if(String(b)!=='Invalid Date'&&b.getDate()===t.getDate()&&b.getMonth()===t.getMonth())out.push({json:{uid,type:'BIRTHDAY',message:`สุขสันต์วันเกิดครับ${name?`คุณ${name}`:''} 🎂\\nหนูมอบส่วนลดพิเศษ 5% สำหรับบริการครั้งถัดไปนะครับ`}});const isBotox=String(r['หัตถการ']||'').toLowerCase().includes('botox');if(isBotox&&String(done)!=='Invalid Date'){const m=(t.getFullYear()-done.getFullYear())*12+(t.getMonth()-done.getMonth());if(m===4&&t.getDate()===done.getDate())out.push({json:{uid,type:'BOTOX_4M',message:`สวัสดีครับ${name?`คุณ${name}`:''} 🙏\\nครบ 4 เดือนหลังฉีด Botox แล้วครับ หากต้องการนัดเข้าประเมิน แจ้งหนูได้เลยนะครับ`}})}}return out.map(x=>({json:{...x.json,debugEvent:'send_candidate'}}));"
      }
    },
