      ],
      "parameters": {
        "jsCode": "const e = $json.body?.events?.[0] || $json.events?.[0] || {}; const userId=e.source?.userId||''; const text=(e.message?.text||'').trim(); const raw=text.replace(/[^0-9]/g,''); const phone=raw.length===9?'0'+raw:raw; return [{userId,text,phone,validPhone:/^0\\d{9}$/.test(phone)}];"
      }
