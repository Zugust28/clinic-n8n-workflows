    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst out = [];\nconst today = new Date();\nconst start = new Date(today.getFullYear(), today.getMonth(), today.getDate());\n\nfunction dayDiff(d1, d2){\n  const a = new Date(d1.getFullYear(), d1.getMonth(), d1.getDate());\n  const b = new Date(d2.getFullYear(), d2.getMonth(), d2.getDate());\n  return Math.round((a - b)/86400000);\n}\n\nfor (const r of rows){\n  const uid = r.UID || r.uid || '';\n  if (!uid) continue;\n  const doneDateRaw = r.วันที่ทำ || r.doneDate || r.date || '';\n  const doneDate = new Date(doneDateRaw);\n  if (String(doneDate) === 'Invalid Date') continue;\n  const d = dayDiff(start, doneDate);\n  if (![1,7,14].includes(d)) continue;\n\n  let message = '';\n  if (d === 1){\n    message = `สวัสดีครับ${r.ชื่อลูกค้า ? 'คุณ' + r.ชื่อลูกค้า : ''} 🙏\\nหนูขออนุญาตติดตามอาการหลังทำหัตถการวันแรก เป็นอย่างไรบ้างครับ มีอาการบวม หรือไม่สบายตัวตรงไหนไหมครับ\\n--------------------------------------------------\\nหนูขอแจ้งรายละเอียดที่เข้ารับบริการนะครับ\\nวันที่ : ${r.วันที่ทำ || '-'}\\n${r.หัตถการ || '-'}\\nยอดชำระ : ${r.ยอดชำระ || '-'}\\n--------------------------------------------------\\nนัดติดตามผล : ${r.นัดติดตาม || '-'}\\n--------------------------------------------------\\nสาขา : ${r.สาขา || 'งามวงศ์วาน'}\\n☎ : 063-446-6931\\nเริ่มรับคิวแรกช่วง 11:30 น.\\nรับคิวสุดท้ายไม่เกิน 20:00 น.\\n⛔คลินิกปิดทุกวันพุธนะครับ⛔`;\n  } else if (d === 7){\n    message = `สวัสดีครับ${r.ชื่อลูกค้า ? 'คุณ' + r.ชื่อลูกค้า : ''} 🙏\\nหนูขอติดตามอาการหลังทำหัตถการครบ 7 วันนะครับ หากมีข้อกังวลหรืออาการผิดปกติ แจ้งหนูได้ทันทีเลยครับ`;\n  } else {\n    message = `สวัสดีครับ${r.ชื่อลูกค้า ? 'คุณ' + r.ชื่อลูกค้า : ''} 🙏\\nหนูขอติดตามผลครบ 14 วันนะครับ หากต้องการเข้าตรวจประเมินเพิ่มเติม สามารถทักมาเพื่อนัดได้เลยครับ`;\n  }\n\n  out.push({json: {uid, followupDay: d, message}});\n}\n\nreturn out;"
      },
