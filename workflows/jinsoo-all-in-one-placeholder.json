      "parameters": {
        "jsCode": "const trigger = $('Parse UID + Phone').item.json;\nconst rows = $input.all().map(i => i.json);\nconst uid = trigger.userId || '';\nconst phone = trigger.phone || '';\n\nconst norm = (p) => String(p || '').replace(/[^0-9]/g, '').replace(/^66/, '0');\n\nconst uidRow = rows.find(r => String(r.UID || r.uid || '').trim() === uid);\nconst phoneRow = rows.find(r => norm(r.เบอร์โทร || r.phone || r.Phone || '') === norm(phone));\n\nreturn [{\n  ...trigger,\n  uidFound: !!uidRow,\n  phoneFound: !!phoneRow,\n  selectedRow: uidRow || phoneRow || null\n}];"
      },
