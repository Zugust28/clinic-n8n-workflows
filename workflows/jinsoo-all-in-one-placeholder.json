        "jsCode": "const e = $json.body?.events?.[0] || $json.events?.[0] || {};\nconst userId = e.source?.userId || '';\nconst replyToken = e.replyToken || '';\nconst text = (e.message?.text || '').trim();\nconst rawPhone = text.replace(/[^0-9]/g, '');\nconst normalizedPhone = rawPhone.length === 10 ? rawPhone : (rawPhone.length === 9 ? '0' + rawPhone : rawPhone);\n\nreturn [{\n  userId,\n  replyToken,\n  inputText: text,\n  phone: normalizedPhone,\n  hasValidPhone: /^0[0-9]{9}$/.test(normalizedPhone)\n}];"
      },
