        "jsCode": "const t=$('Parse Event + Phone').item.json; const rows=$input.all().map(i=>i.json); const norm=p=>String(p||'').replace(/[^0-9]/g,'').replace(/^66/,'0'); const uidFound=rows.some(r=>String(r.UID||r.uid||'').trim()===String(t.userId||'').trim()); const phoneFound=rows.some(r=>norm(r['เบอร์โทร']||r.phone||r.Phone||'')===norm(t.phone)); return [{...t,uidFound,phoneFound,debugEvent:'match_phone_checked'}];"
